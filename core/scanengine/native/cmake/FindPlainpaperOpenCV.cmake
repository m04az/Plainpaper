# Resolves OpenCV 4.13 for the three build flavours (research R1):
#   android / host: a CMake package (OpenCV_DIR) with static libs; link core + imgproc.
#   ios: the opencv2.xcframework slice (PP_OPENCV_XCFRAMEWORK); headers only, the app links it.
function(plainpaper_link_opencv target)
    if(PP_PLATFORM STREQUAL "ios")
        if(NOT DEFINED PP_OPENCV_XCFRAMEWORK)
            message(FATAL_ERROR "PP_OPENCV_XCFRAMEWORK must point at opencv2.xcframework for iOS builds")
        endif()
        if(CMAKE_OSX_SYSROOT MATCHES "iphonesimulator")
            set(_slice "ios-arm64_x86_64-simulator")
        else()
            set(_slice "ios-arm64")
        endif()
        set(_slice_dir "${PP_OPENCV_XCFRAMEWORK}/${_slice}")
        if(NOT EXISTS "${_slice_dir}/opencv2.framework/Headers/core.hpp")
            message(FATAL_ERROR "OpenCV slice not found: ${_slice_dir}")
        endif()
        target_compile_options(${target} PRIVATE "-F${_slice_dir}")
    else()
        set(OpenCV_STATIC ON)
        find_package(OpenCV REQUIRED COMPONENTS core imgproc)
        target_include_directories(${target} PRIVATE ${OpenCV_INCLUDE_DIRS})
        target_link_libraries(${target} PRIVATE ${OpenCV_LIBS})
        message(STATUS "OpenCV ${OpenCV_VERSION} from ${OpenCV_DIR} (${OpenCV_LIBS})")
    endif()
endfunction()
